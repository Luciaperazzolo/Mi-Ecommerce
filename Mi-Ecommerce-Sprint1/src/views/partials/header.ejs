<header class="main-header">
    <a href="/" class="logo" style="text-decoration: none;">Mi<span>Ecommerce</span></a>
    
    <form action="/products/search" method="GET" class="search-container">
        <input type="text" name="query" placeholder="Buscar productos..." class="search-bar">
        <button type="submit" style="background: none; border: none; padding: 0; cursor: pointer;">
            <i class="fas fa-search search-icon"></i>
        </button>
    </form>
    
    <div class="header-icons">
        <a href="/products" class="link-productos-header">Productos</a>
        <div class="cart-wrapper">
            <a href="/cart">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-badge"><%= cartCount %></span>
            </a>
        </div>
        <div class="user-profile">
            <i class="fas fa-user user-icon"></i>
            <% if (user) { %>
                <span><%= user.name.split(' ')[0] %></span>
                <a href="/logout" style="font-size: 12px; color: inherit; margin-left: 5px;">(Salir)</a>
            <% } else { %>
                <a href="/login" class="user-login">Iniciar sesión</a>
            <% } %>
        </div>
    </div>
</header>
