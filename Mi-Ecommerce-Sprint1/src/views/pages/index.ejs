<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inicio - MiEcommerce</title>

    <link rel="stylesheet" href="/CSS/header.css">
    <link rel="stylesheet" href="/CSS/footer.css">
    <link rel="stylesheet" href="/CSS/index.css">
    <link rel="stylesheet" href="/CSS/product.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

</head>
<body>

    <!-- CONTENIDO PRINCIPAL -->
    <main>
        
        <!-- BARRA DE CATEGORIAS -->
        <section class="categories-container">
            <div class="category-item">
                <a href="/products/category/Electronica">
                    <img src="/imagenes-index/electronica.png" alt="Electrónica">
                    <span>Electrónica</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Alimentos">
                    <img src="/imagenes-index/alimentos.png" alt="Alimentos">
                    <span>Alimentos</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Bebidas">
                    <img src="/imagenes-index/bebidas.png" alt="Bebidas">
                    <span>Bebidas</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Indumentaria">
                    <img src="/imagenes-index/indumentaria.png" alt="Indumentaria">
                    <span>Indumentaria</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Juegos">
                    <img src="/imagenes-index/juegos.png" alt="Juegos">
                    <span>Juegos</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Automotor">
                    <img src="/imagenes-index/automotor.png" alt="Automotor">
                    <span>Automotor</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Hogar">
                    <img src="/imagenes-index/hogar.png" alt="Hogar">
                    <span>Hogar</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Otros">
                    <img src="/imagenes-index/otros.png" alt="Otros">
                    <span>Otros</span>
                </a>
            </div>
        </section>

        <!-- PRODUCT HERO -->
        <section class="banner-promociones">
            <div class="contenedor-publicidades">
                
                <div class="tarjeta-publicidad publico-disney">
                    <a href="https://www.disneyplus.com" target="_blank">
                    
                    <div class="contenido-tarjeta-info">
                        <div class="contenedor-logo-promo">
                            <img src="/imagenes-index/disney.jpg" alt="Logo Disney+">
                        </div>
                        <div class="contenedor-texto-promo">
                            <p class="titulo-promo">
                                50% OFF en Combo Plus
                            </p>
                            <p class="detalle-promo">
                                Canjeando 50.000 puntos MiEcommerce.
                            </p>
                        </div>
                        </a>
                    </div>
                </div>

                <div class="tarjeta-publicidad publico-hbo">
                    <div class="contenido-tarjeta-info">
                        <a href= "https://www.hbomax.com/" target="_blank">
                        <div class="contenedor-logo-promo">
                            <img src="/imagenes-index/hbo.webp" alt="Logo HBO Max">
                        </div>
                        <div class="contenedor-texto-promo">
                            <p class="titulo-promo">
                                50% OFF en HBO Max
                            </p>
                            <p class="detalle-promo">
                                Canjeando 50.000 puntos MiEcommerce.
                            </p>
                        </div>
                        </a>
                    </div>
                </div>
            </div>
        </section>

          <!-- PRODUCTOS SUGERIDOS -->
        <section class="productos-seccion">
            <h3>Te puede interesar</h3>
            <div class="grilla-productos">
                <% if (suggestedProducts && suggestedProducts.length > 0) { %>
                    <% suggestedProducts.forEach(product => { %>
                        <article class="tarjeta-chica">
                            <a href="/products/<%= product.id %>" style="text-decoration: none; color: inherit;">
                                <img src="/Imagenes-productos/<%= product.image || 'fallback.png' %>" alt="<%= product.name %>">
                                <div class="cuerpo-tarjeta">
                                    <p class="nombre-relacionado"><%= product.name %></p>
                                    <div class="precio-relacionado">
                                        <span class="puntos"><%= product.price %></span>
                                        <span class="label">PUNTOS</span>
                                    </div>
                                </div>
                            </a>
                        </article>
                    <% }) %>
                <% } else { %>
                    <p>No hay productos sugeridos.</p>
                <% } %>
            </div>
        </section>


        <!-- LOS MÁS PEDIDOS -->
<section class="productos-seccion">
    <h3>Los más pedidos</h3>
    <div class="grilla-productos">
        <% if (popularProducts && popularProducts.length > 0) { %>
            <% popularProducts.forEach(product => { %>
                <article class="tarjeta-chica">
                    <a href="/products/<%= product.id %>" style="text-decoration: none; color: inherit;">
                        <img src="/Imagenes-productos/<%= product.image || 'fallback.png' %>" alt="<%= product.name %>">
                        <div class="cuerpo-tarjeta">
                            <p class="nombre-relacionado"><%= product.name %></p>
                            <div class="precio-relacionado">
                                <span class="puntos"><%= product.price %></span>
                                <span class="label">PUNTOS</span>
                            </div>
                        </div>
                    </a>
                </article>
            <% }) %>
        <% } else { %>
            <p>No hay productos destacados.</p>
        <% } %>
    </div>
</section>


        <!-- BARRA DE CATEGORIAS REPETIDA -->

        <section class="categories-container">
            <div class="category-item">
                <a href="/products/category/Electronica">
                    <img src="/imagenes-index/electronica.png" alt="Electrónica">
                    <span>Electrónica</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Alimentos">
                    <img src="/imagenes-index/alimentos.png" alt="Alimentos">
                    <span>Alimentos</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Bebidas">
                    <img src="/imagenes-index/bebidas.png" alt="Bebidas">
                    <span>Bebidas</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Indumentaria">
                    <img src="/imagenes-index/indumentaria.png" alt="Indumentaria">
                    <span>Indumentaria</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Juegos">
                    <img src="/imagenes-index/juegos.png" alt="Juegos">
                    <span>Juegos</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Automotor">
                    <img src="/imagenes-index/automotor.png" alt="Automotor">
                    <span>Automotor</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Hogar">
                    <img src="/imagenes-index/hogar.png" alt="Hogar">
                    <span>Hogar</span>
                </a>
            </div>

            <div class="category-item">
                <a href="/products/category/Otros">
                    <img src="/imagenes-index/otros.png" alt="Otros">
                    <span>Otros</span>
                </a>
            </div>
        </section>
    </main>

</body>
</html> 