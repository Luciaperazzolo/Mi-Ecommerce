<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - MiEcommerce</title>
    <link rel="stylesheet" href="/CSS/auth.css">
</head>
<body>

    <main>
        <h2>Iniciar Sesión</h2>

        <% if (typeof error !== 'undefined' && error) { %>
            <p style="color: #e63946; text-align: center; margin-bottom: 10px;"><%= error %></p>
        <% } %>

        <% if (typeof query !== 'undefined' && query.registered) { %>
            <p style="color: green; text-align: center; margin-bottom: 10px;">¡Registro exitoso! Ya podés iniciar sesión.</p>
        <% } %>

        <form action="/login" method="POST">

            <label for="email">Email</label>
            <input id="email" name="email" type="email" required>

            <label for="password">Contraseña</label>
            <input id="password" name="password" type="password" required>

            <button type="submit">Iniciar Sesión</button>
        </form>

        <p>¿No tenés cuenta?</p>
        <a href="/register">Registrarse</a>

        <a href="/">Volver al inicio</a>
    </main>

</body>
</html>
